{
  "name": "quadrix",
  "private": true,
  "version": "0.22.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "tsc --noEmit && eslint . && prettier --check .",
    "format": "prettier --write .",
    "check:version": "git fetch --quiet --no-tags origin main && node tools/version-check.mjs bump FETCH_HEAD",
    "prepare": "node tools/install-hooks.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
